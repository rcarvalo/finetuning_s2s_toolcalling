# Copier en `.env` (jamais commité) et remplir.

# Hugging Face — download des checkpoints/datasets privés, push des adaptateurs
HF_TOKEN=

# Suivi d'entraînement
WANDB_KEY=

# Génération du dataset tool-calling (offline)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Backend de recherche web de l'agent (repli DuckDuckGo si absent)
TAVILY_API_KEY=

# PostgreSQL de l'outil query_database (rôle LECTURE SEULE, cf. configs/sql/)
RECEPTION_DATABASE_URL=

# Racine des checkpoints locaux utilisée par les démos/CLIs
LFM2_CHECKPOINT_ROOT=

# RunPod — inférence serverless (lfm2_audio.remote) + entraînement SkyPilot
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Suivi d'entraînement sur pod (nom standard lu par wandb ; WANDB_KEY reste
# celui des notebooks Colab)
WANDB_API_KEY=

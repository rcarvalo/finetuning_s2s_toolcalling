# syntax=docker/dockerfile:1
# Worker serverless RunPod — backend de RÉFÉRENCE (liquid-audio PyTorch).
#
# Image du PREMIER déploiement : elle valide la plomberie serverless (client →
# handler → streaming → coût) avec le backend dont le flux audio est déjà
# prouvé, pendant que la parité GPU du plugin vLLM-Omni (critère P2) reste en
# cours. Passer ensuite à `Dockerfile.serve` (vLLM-Omni) pour la latence.
#
# Pas de build-arg ni de secret ici : le flux « GitHub → build RunPod » n'en
# accepte pas. Tout est donc figé sur le modèle PUBLIC de base ; on choisit
# l'image en pointant RunPod sur CE chemin de Dockerfile. Pour un checkpoint
# privé, builder en local avec `Dockerfile.serve` et ses `--build-arg`.
#
# Build local (optionnel, sinon RunPod le fait depuis GitHub) :
#   docker build --platform linux/amd64 -f infra/Dockerfile.serve.liquid \
#     -t <user>/lfm2-audio-serverless:liquid .

FROM python:3.12-slim

# build-essential is not optional: Triton JIT-compiles its CUDA kernels on first
# use and python:*-slim ships no C compiler. Without it the worker dies while
# loading the model with "InductorError: Failed to find C compiler" — and it
# dies AFTER the image has been pulled, which reads as a slow start rather than
# a crash. That misdiagnosis cost an afternoon; hence this comment.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY python ./python
COPY infra/handler.py infra/bake_checkpoint.py ./infra/

RUN uv pip install --system ".[serving-liquid,client]" "runpod>=1.7"

# TORCHDYNAMO_DISABLE: even with a compiler present, a serverless worker has no
# business spending its cold start compiling kernels it will use a handful of
# times before scaling back to zero.
ENV LFM2_CHECKPOINT=LiquidAI/LFM2.5-Audio-1.5B \
    LFM2_BACKEND=liquid \
    HF_HOME=/models/hf \
    PYTHONUNBUFFERED=1 \
    TORCHDYNAMO_DISABLE=1

# Poids téléchargés au BUILD : le cold start ne paie que le chargement en VRAM.
RUN python infra/bake_checkpoint.py

CMD ["python", "-u", "infra/handler.py"]
